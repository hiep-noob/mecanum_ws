colcon build --packages-up-to slam_gmapping
#lệnh chạy gmapping:😀️
cd ~/mecanum_ws
source install/setup.bash
ros2 launch mecanum gmapping.launch.py
#lệnh chạy cartographer 3d:😀️
cd ~/mecanum_ws
source install/setup.bash
ros2 launch mecanum cartographer_3d.launch.py
#lệnh dừng carto3d vẽ (chạy trước lệnh lưu map)😀️
ros2 run nav2_map_server map_saver_cli -f ~/mecanum_ws/src/mecanum/maps/smallhouse_1_cartographer2d
#lệnh lưu map 3d carto:😀️
ros2 service call /finish_trajectory cartographer_ros_msgs/srv/FinishTrajectory "{trajectory_id: 0}"
ros2 service call /write_state cartographer_ros_msgs/srv/WriteState "{filename: '${HOME}/mecanum_ws/src/mecanum/maps/small_house_3d.pbstream', include_unfinished_submaps: true}"
#lệnh ghi bag:😀️
ros2 bag record -o bag_small_house_3d \
/points_raw \
/imu \
/odom \
/tf \
/tf_static \
/scan_matched_points2
#lệnh chuyển từ file pbstream sang ply:😀️
ros2 run cartographer_ros cartographer_assets_writer \
  -configuration_directory src/mecanum/config \
  -configuration_basename assets_writer_3d.lua \
  -urdf_filename src/mecanum/urdf/mecanum.urdf \
  -bag_filenames src/mecanum/bags/bag_turtlebot_house \
  -pose_graph_filename src/mecanum/maps/turtlebot_house_3d.pbstream
